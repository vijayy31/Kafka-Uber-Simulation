      "updated": 1790510857834,
      "created": 1790510612189,
      "link": null,
      "locked": false,
      "text": "Kafka hashes the key to determine the partition.",
      "fontSize": 16.326203300755637,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Kafka hashes the key to determine the partition.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "REtSHac-_4IyEMy-C2PUt",
      "type": "text",
      "x": -11.469314410736587,
      "y": 6138.321873604751,
      "width": 188.7321497155344,
      "height": 179.6665263886048,
      "angle": 0,
      "strokeColor": "#e8590c",
      "backgroundColor": "#15aabf",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0s",
      "roundness": null,
      "seed": 213404540,
      "version": 444,
      "versionNonce": 633774460,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790510857834,
      "created": 1790510641224,
      "link": null,
      "locked": false,
      "text": "\nFor example:\n\nride_10001\n     ↓\nKafka partitioner\n     ↓\nPartition 1\n\nThen all events with:\n\nride_id = ride_10001",
      "fontSize": 11.977768425906987,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\nFor example:\n\nride_10001\n     ↓\nKafka partitioner\n     ↓\nPartition 1\n\nThen all events with:\n\nride_id = ride_10001",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "j7C9y63XNaQs4At3X-gbT",
      "type": "text",
      "x": -83.57690634718318,
      "y": 6337.3531057423725,
      "width": 590.677020486963,
      "height": 18.42550217610448,
      "angle": 0,
      "strokeColor": "#e8590c",
      "backgroundColor": "#15aabf",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0t",
      "roundness": null,
