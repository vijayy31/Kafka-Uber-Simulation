      "boundElements": null,
      "updated": 1790510879908,
      "created": 1790510701380,
      "link": null,
      "locked": false,
      "text": "will normally go to the same partition, preserving their order within that partition.",
      "fontSize": 14.74040174088358,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "will normally go to the same partition, preserving their order within that partition.",
