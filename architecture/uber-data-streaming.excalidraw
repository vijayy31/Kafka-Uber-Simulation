      "versionNonce": 344656892,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790511103531,
      "created": 1790510962523,
      "link": null,
      "locked": false,
      "text": "                     KAFKA\n                       │\n       ┌────────┼─────────┐\n       │               │                │\n       ▼              ▼               ▼\n ride-events    driver-location      payments\n       │               │                │\n       │               │                │\n   key=ride_id    key=driver_id    key=ride_id\n       │               │                │\n       ▼               ▼                ▼\n   3 partitions    3 partitions     3 partitions\n   RF = 3          RF = 3            RF = 3",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "                     KAFKA\n                       │\n       ┌────────┼─────────┐\n       │               │                │\n       ▼              ▼               ▼\n ride-events    driver-location      payments\n       │               │                │\n       │               │                │\n   key=ride_id    key=driver_id    key=ride_id\n       │               │                │\n       ▼               ▼                ▼\n   3 partitions    3 partitions     3 partitions\n   RF = 3          RF = 3            RF = 3",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
