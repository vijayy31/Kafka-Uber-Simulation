      "updated": 1790509643495,
      "created": 1790509622353,
      "link": null,
      "locked": false,
      "text": "For example:\n\n10:30:01 → driver_2001 → location A\n10:30:03 → driver_2001 → location B\n10:30:05 → driver_2001 → location C\n10:30:07 → driver_2001 → location D\n\nThis gives us a nice real-time Kafka workload.",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "For example:\n\n10:30:01 → driver_2001 → location A\n10:30:03 → driver_2001 → location B\n10:30:05 → driver_2001 → location C\n10:30:07 → driver_2001 → location D\n\nThis gives us a nice real-time Kafka workload.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
